{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "for": { "type": "string" },
        "severity": { "type": "string" }
      }
    },
    "managedSecret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "dsn": { "type": "string" },
        "password": { "type": "string" },
        "clientSecret": { "type": "string" },
        "encryptionKey": { "type": "string" },
        "accessKeyId": { "type": "string" },
        "accountId": { "type": ["string", "number"] },
        "licenseKey": { "type": "string" },
        "secretAccessKey": { "type": "string" }
      }
    },
    "thresholdAlert": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "threshold": {
          "type": ["number", "string"],
          "minimum": 0,
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "for": { "type": "string" },
        "severity": { "type": "string" }
      }
    }
  },
  "properties": {
    "cnpg-operator": { "type": "object" },
    "valkey": { "type": "object" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "global": { "type": "object" },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "leaderElection": { "type": "boolean" },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": { "type": "object", "additionalProperties": { "type": ["string", "integer", "number"] } },
            "requests": { "type": "object", "additionalProperties": { "type": ["string", "integer", "number"] } },
            "claims": { "type": "array", "items": { "type": "object" } }
          }
        },
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zone": { "type": "string" },
        "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": { "type": "object", "additionalProperties": { "type": ["string", "integer", "number"] } },
            "requests": { "type": "object", "additionalProperties": { "type": ["string", "integer", "number"] } },
            "claims": { "type": "array", "items": { "type": "object" } }
          }
        },
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" },
        "securityContext": {
          "type": "object",
          "properties": {
            "allowPrivilegeEscalation": { "type": "boolean" },
            "privileged": { "type": "boolean" },
            "readOnlyRootFilesystem": { "type": "boolean" },
            "runAsUser": { "type": "integer" },
            "runAsGroup": { "type": "integer" },
            "runAsNonRoot": { "type": "boolean" },
            "procMount": { "type": "string" },
            "capabilities": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "add": { "type": "array", "items": { "type": "string" } },
                "drop": { "type": "array", "items": { "type": "string" } }
              }
            },
            "seLinuxOptions": { "type": "object" },
            "seccompProfile": { "type": "object" },
            "appArmorProfile": { "type": "object" },
            "windowsOptions": { "type": "object" }
          }
        },
        "podSecurityContext": {
          "type": "object",
          "properties": {
            "runAsUser": { "type": "integer" },
            "runAsGroup": { "type": "integer" },
            "runAsNonRoot": { "type": "boolean" },
            "fsGroup": { "type": "integer" },
            "fsGroupChangePolicy": { "type": "string", "enum": ["OnRootMismatch", "Always"] },
            "supplementalGroups": { "type": "array", "items": { "type": "integer" } },
            "supplementalGroupsPolicy": { "type": "string" },
            "sysctls": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "value"],
                "properties": {
                  "name": { "type": "string" },
                  "value": { "type": "string" }
                }
              }
            },
            "seLinuxOptions": { "type": "object" },
            "seccompProfile": { "type": "object" },
            "appArmorProfile": { "type": "object" },
            "windowsOptions": { "type": "object" }
          }
        }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["anonymous", "local", "header", "oidc"] },
            "anonymous": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "role": { "type": "string" } }
            },
            "defaultRole": { "type": "string" },
            "local": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "bootstrapAdmin": { "type": "string" },
                "existingSecret": { "type": "string" },
                "existingSecretKey": { "type": "string" },
                "secret": { "$ref": "#/$defs/managedSecret" }
              }
            },
            "header": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "userHeader": { "type": "string" },
                "groupsHeader": { "type": "string" },
                "groupsDelimiter": { "type": "string" },
                "trustedProxyCIDRs": { "type": "array", "items": { "type": "string" } }
              }
            },
            "oidc": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "issuer": { "type": "string" },
                "clientID": { "type": "string" },
                "existingSecret": { "type": "string" },
                "existingSecretKey": { "type": "string" },
                "secret": { "$ref": "#/$defs/managedSecret" },
                "redirectURL": { "type": "string" },
                "scopes": { "type": "array", "items": { "type": "string" } },
                "usernameClaim": { "type": "string" },
                "groupsClaim": { "type": "string" }
              }
            },
            "session": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ttl": { "type": "string" },
                "cookieName": { "type": "string" },
                "secure": { "type": "boolean" }
              }
            }
          }
        },
        "controller": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string" },
            "timeout": { "type": "string" },
            "grpcAddr": { "type": "string" },
            "grpcAddress": { "type": "string" }
          }
        },
        "prometheus": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string" },
            "queryTimeout": { "type": "string" },
            "maxRange": { "type": "string" },
            "maxResponseBytes": { "type": "integer", "minimum": 1 }
          }
        },
        "valkey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["bundled",
              "dependency", "external", "disabled"]
            },
            "address": { "type": "string" },
            "dialTimeout": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string" },
            "secret": { "$ref": "#/$defs/managedSecret" },
            "podSecurityContext": { "type": "object" },
            "securityContext": { "type": "object" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "repository": { "type": "string" },
                "tag": { "type": "string" },
                "pullPolicy": {
                  "type": "string",
                  "enum": ["Always", "IfNotPresent", "Never"]
                }
              }
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "limits": { "type": "object", "additionalProperties": { "type": ["string", "integer", "number"] } },
                "requests": { "type": "object", "additionalProperties": { "type": ["string", "integer", "number"] } },
                "claims": { "type": "array", "items": { "type": "object" } }
              }
            }
          }
        },
        "rateLimit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runsPerMinute": { "type": "integer", "minimum": 0 },
            "loginPerMinute": { "type": "integer", "minimum": 0 }
          }
        },
        "scheduler": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "tickInterval": { "type": "string" }
          }
        },
        "mtr": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enrichment": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "rdns": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "timeoutMs": { "type": "integer", "minimum": 1 }
                  }
                },
                "geoip": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                        "mode": { "type": "string", "enum": ["", "auto", "volume", "disabled"] },
                        "editions": { "type": "array", "items": { "type": "string" } },
                        "updateIntervalHours": { "type": "integer", "minimum": 0 },
                        "reloadInterval": { "type": "string" },
                        "image": { "type": "object" },
                        "resources": { "type": "object" },
                        "securityContext": { "type": "object" },
                        "existingSecret": { "type": "string" },
                        "accountIdKey": { "type": "string" },
                        "licenseKeyKey": { "type": "string" },
                        "secret": { "$ref": "#/$defs/managedSecret" },
                    "asnPath": { "type": "string" },
                    "cityPath": { "type": "string" },
                    "volume": { "type": "object" }
                  }
                },
                "ttl": { "type": "string" }
              }
            }
          }
        },
        "kubernetesContext": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string" },
            "resyncInterval": { "type": "string" }
          }
        },
        "webhooks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string" },
            "secret": { "$ref": "#/$defs/managedSecret" },
            "encryptionKeySecret": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "key": { "type": ["string", "null"] }
              }
            },
            "alertPollInterval": { "type": "string" }
          }
        },
        "alerting": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string" },
            "syncInterval": { "type": "string" },
            "bundleName": { "type": "string" }
          }
        },
        "securityContext": { "type": "object" },
        "podSecurityContext": {
          "type": "object",
          "properties": {
            "runAsUser": { "type": "integer" },
            "runAsGroup": { "type": "integer" },
            "runAsNonRoot": { "type": "boolean" },
            "fsGroup": { "type": "integer" },
            "fsGroupChangePolicy": { "type": "string", "enum": ["OnRootMismatch", "Always"] },
            "supplementalGroups": { "type": "array", "items": { "type": "integer" } },
            "supplementalGroupsPolicy": { "type": "string" },
            "sysctls": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "value"],
                "properties": {
                  "name": { "type": "string" },
                  "value": { "type": "string" }
                }
              }
            },
            "seLinuxOptions": { "type": "object" },
            "seccompProfile": { "type": "object" },
            "appArmorProfile": { "type": "object" },
            "windowsOptions": { "type": "object" }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["cnpg", "external", "disabled"]
            },
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string" },
            "secret": { "$ref": "#/$defs/managedSecret" },
            "maxConns": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "connectTimeout": { "type": "string" },
            "migrateOnStart": { "type": "boolean" },
            "retentionDays": { "type": "integer", "minimum": 0, "maximum": 36500 },
            "cnpg": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "instances": { "type": "integer", "minimum": 1, "maximum": 16 },
                "imageName": { "type": "string" },
                "storage": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "size": { "type": "string" },
                    "storageClass": { "type": "string" }
                  }
                },
                "resources": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "limits": { "type": "object", "additionalProperties": { "type": ["string", "integer", "number"] } },
                    "requests": { "type": "object", "additionalProperties": { "type": ["string", "integer", "number"] } },
                    "claims": { "type": "array", "items": { "type": "object" } }
                  }
                },
                "backup": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "schedule": { "type": "string" },
                    "destinationPath": { "type": "string" },
                    "endpointURL": { "type": "string" },
                    "credentialsSecret": { "type": "string" },
                    "existingSecret": { "type": "string" },
                    "secret": { "$ref": "#/$defs/managedSecret" }
                  }
                }
              }
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prometheusEgress": { "type": "array", "items": { "type": "object" } },
            "valkeyEgress": { "type": "array", "items": { "type": "object" } },
            "databaseEgress": { "type": "array", "items": { "type": "object" } },
            "oidcEgress": { "type": "array", "items": { "type": "object" } },
            "kubeAPIEgress": { "type": "array", "items": { "type": "object" } },
            "geoipEgress": { "type": "array", "items": { "type": "object" } }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
            "hosts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["host"],
                "properties": {
                  "host": { "type": "string" },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["path"],
                      "properties": {
                        "path": { "type": "string" },
                        "pathType": { "type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"] }
                      }
                    }
                  }
                }
              }
            },
            "tls": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "secretName": { "type": "string" },
                  "hosts": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": { "type": "object", "additionalProperties": { "type": ["string", "integer", "number"] } },
            "requests": { "type": "object", "additionalProperties": { "type": ["string", "integer", "number"] } },
            "claims": { "type": "array", "items": { "type": "object" } }
          }
        },
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" },
        "pdb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["httpPort", "grpcPort"],
      "properties": {
        "metricsPrefix": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "httpPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "grpcPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "logFormat": { "type": "string", "enum": ["json", "text"] },
        "failureDomainLabel": { "type": "string" },
        "controllerAgentTtl": { "type": "string" },
        "checkers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tcp": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "interval": { "type": "string" },
                "timeout": { "type": "string" }
              }
            },
            "udp": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "interval": { "type": "string" },
                "timeout": { "type": "string" },
                "packets": { "type": "integer", "minimum": 1, "maximum": 100 }
              }
            },
            "icmp": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "interval": { "type": "string" },
                "timeout": { "type": "string" }
              }
            },
            "dns": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "interval": { "type": "string" },
                "timeout": { "type": "string" },
                "hosts": { "type": "array", "items": { "type": "string" } },
                "resolvers": { "type": "array", "items": { "type": "string" } }
              }
            },
            "http": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "interval": { "type": "string" },
                "timeout": { "type": "string" },
                "targets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["url"],
                    "properties": {
                      "url": { "type": "string", "format": "uri" },
                      "method": { "type": "string", "enum": ["GET", "HEAD"] },
                      "expectStatus": { "type": "integer" },
                      "bodyPattern": { "type": "string" }
                    }
                  }
                }
              }
            },
            "mtr": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cooldown": { "type": "string" },
                "maxHops": { "type": "integer", "minimum": 1, "maximum": 64 }
              }
            },
            "external": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "allowedCidrs": { "type": "array", "items": { "type": "string" } },
                "deniedCidrs": { "type": "array", "items": { "type": "string" } },
                "maxTargets": { "type": "integer", "minimum": 0 },
                "timeout": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "dashboards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string" },
        "label": { "type": "string" },
        "labelValue": { "type": "string" },
        "folder": { "type": "string" },
        "extraLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" }
      }
    },
    "prometheusRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "udpLossHigh": { "$ref": "#/$defs/thresholdAlert" },
        "tcpChecksFailing": { "$ref": "#/$defs/thresholdAlert" },
        "pairWentSilent": { "$ref": "#/$defs/alert" },
        "dnsChecksFailing": { "$ref": "#/$defs/thresholdAlert" },
        "externalChecksFailing": { "$ref": "#/$defs/thresholdAlert" },
        "kconmonAgentsMissing": { "$ref": "#/$defs/alert" },
        "kconmonControllerDown": { "$ref": "#/$defs/alert" },
        "additionalRules": { "type": "array", "items": { "type": "object" } },
        "rules": { "type": "array", "items": { "type": "object" } }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
