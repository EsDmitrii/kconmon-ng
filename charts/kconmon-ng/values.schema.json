{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "controller": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "leaderElection": { "type": "boolean" },
        "events": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" }
      }
    },
    "agent": {
      "type": "object",
      "properties": {
        "zone": { "type": "string" },
        "podAnnotations": { "type": "object" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "resources": { "type": "object" },
        "tolerations": { "type": "array" },
        "securityContext": { "type": "object" },
        "podSecurityContext": { "type": "object" }
      }
    },
    "console": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["anonymous", "local", "header", "oidc"] },
            "anonymous": {
              "type": "object",
              "properties": { "role": { "type": "string" } }
            },
            "defaultRole": { "type": "string" },
            "local": {
              "type": "object",
              "properties": {
                "bootstrapAdmin": { "type": "string" },
                "existingSecret": { "type": "string" },
                "existingSecretKey": { "type": "string" }
              }
            },
            "header": {
              "type": "object",
              "properties": {
                "userHeader": { "type": "string" },
                "groupsHeader": { "type": "string" },
                "groupsDelimiter": { "type": "string" },
                "trustedProxyCIDRs": { "type": "array", "items": { "type": "string" } }
              }
            },
            "oidc": {
              "type": "object",
              "properties": {
                "issuer": { "type": "string" },
                "clientID": { "type": "string" },
                "existingSecret": { "type": "string" },
                "existingSecretKey": { "type": "string" },
                "redirectURL": { "type": "string" },
                "scopes": { "type": "array", "items": { "type": "string" } },
                "usernameClaim": { "type": "string" },
                "groupsClaim": { "type": "string" }
              }
            },
            "session": {
              "type": "object",
              "properties": {
                "ttl": { "type": "string" },
                "cookieName": { "type": "string" },
                "secure": { "type": "boolean" }
              }
            }
          }
        },
        "controller": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "timeout": { "type": "string" },
            "grpcAddr": { "type": "string" }
          }
        },
        "prometheus": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "queryTimeout": { "type": "string" },
            "maxRange": { "type": "string" },
            "maxResponseBytes": { "type": "integer", "minimum": 1 }
          }
        },
        "valkey": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["bundled", "external", "disabled"]
            },
            "address": { "type": "string" },
            "dialTimeout": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "image": {
              "type": "object",
              "properties": {
                "repository": { "type": "string" },
                "tag": { "type": "string" },
                "pullPolicy": {
                  "type": "string",
                  "enum": ["Always", "IfNotPresent", "Never"]
                }
              }
            },
            "resources": { "type": "object" }
          }
        },
        "podSecurityContext": { "type": "object" },
        "database": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["cnpg", "external", "disabled"]
            },
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string" },
            "maxConns": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "connectTimeout": { "type": "string" },
            "migrateOnStart": { "type": "boolean" },
            "retentionDays": { "type": "integer", "minimum": 0, "maximum": 36500 },
            "cnpg": {
              "type": "object",
              "properties": {
                "instances": { "type": "integer", "minimum": 1, "maximum": 16 },
                "imageName": { "type": "string" },
                "storage": {
                  "type": "object",
                  "properties": {
                    "size": { "type": "string" },
                    "storageClass": { "type": "string" }
                  }
                },
                "resources": { "type": "object" },
                "backup": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "schedule": { "type": "string" },
                    "destinationPath": { "type": "string" },
                    "endpointURL": { "type": "string" },
                    "credentialsSecret": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "properties": {
            "prometheusEgress": { "type": "array" },
            "valkeyEgress": { "type": "array" },
            "databaseEgress": { "type": "array" },
            "oidcEgress": { "type": "array" }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "annotations": { "type": "object" },
            "hosts": { "type": "array" },
            "tls": { "type": "array" }
          }
        },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "pdb": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "required": ["httpPort", "grpcPort"],
      "properties": {
        "metricsPrefix": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "httpPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "grpcPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "logFormat": { "type": "string", "enum": ["json", "text"] },
        "failureDomainLabel": { "type": "string" },
        "controllerAgentTtl": { "type": "string" },
        "checkers": {
          "type": "object",
          "properties": {
            "tcp": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "interval": { "type": "string" },
                "timeout": { "type": "string" }
              }
            },
            "udp": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "interval": { "type": "string" },
                "timeout": { "type": "string" },
                "packets": { "type": "integer", "minimum": 1, "maximum": 100 }
              }
            },
            "icmp": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "interval": { "type": "string" },
                "timeout": { "type": "string" }
              }
            },
            "dns": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "interval": { "type": "string" },
                "hosts": { "type": "array", "items": { "type": "string" } },
                "resolvers": { "type": "array", "items": { "type": "string" } }
              }
            },
            "http": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "interval": { "type": "string" },
                "timeout": { "type": "string" },
                "targets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["url"],
                    "properties": {
                      "url": { "type": "string", "format": "uri" },
                      "method": { "type": "string", "enum": ["GET", "HEAD"] },
                      "expectStatus": { "type": "integer" },
                      "bodyPattern": { "type": "string" }
                    }
                  }
                }
              }
            },
            "mtr": {
              "type": "object",
              "properties": {
                "cooldown": { "type": "string" },
                "maxHops": { "type": "integer", "minimum": 1, "maximum": 64 }
              }
            }
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" }
      }
    },
    "prometheusRule": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "rules": { "type": "array" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "prometheusNamespace": { "type": "string" }
      }
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": "integer", "minimum": 0 }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      }
    }
  }
}
