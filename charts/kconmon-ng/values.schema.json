{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "for": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        }
      }
    },
    "managedSecret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "dsn": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "clientSecret": {
          "type": "string"
        },
        "encryptionKey": {
          "type": "string"
        },
        "accessKeyId": {
          "type": "string"
        },
        "accountId": {
          "type": [
            "string",
            "number"
          ]
        },
        "licenseKey": {
          "type": "string"
        },
        "secretAccessKey": {
          "type": "string"
        }
      }
    },
    "thresholdAlert": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "threshold": {
          "description": "A RATIO in 0.0-1.0, never a percent. Every rule using this shape compares a rate ratio directly, so a percent-shaped 5 renders `> 5` and can never fire \u2014 silently, because the render succeeds and the alert simply never triggers. The bound is what turns that into a refusal at install time.",
          "type": [
            "number",
            "string"
          ],
          "minimum": 0,
          "maximum": 1,
          "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"
        },
        "for": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "global": {
      "type": "object"
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "leaderElection": {
          "type": "boolean"
        },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "externalGateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "service": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "NodePort",
                    "LoadBalancer"
                  ],
                  "description": "No ClusterIP: an external agent cannot reach one."
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "nodePort": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535,
                  "description": "0 lets the apiserver pick; the valid range is the apiserver's --service-node-port-range, which the chart cannot know."
                },
                "externalTrafficPolicy": {
                  "type": "string",
                  "enum": [
                    "",
                    "Cluster",
                    "Local"
                  ]
                },
                "loadBalancerSourceRanges": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "secretName": {
                  "type": "string"
                },
                "clientCaKey": {
                  "type": "string"
                }
              }
            },
            "bootstrapToken": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "secretName": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              }
            }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "integer",
                  "number"
                ]
              }
            },
            "requests": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "integer",
                  "number"
                ]
              }
            },
            "claims": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "pdb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zone": {
          "type": "string"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "detail": {
              "description": "Scrape-time cardinality valve on the agent ServiceMonitor. full keeps everything (~70 series per directed pair); counters-only drops the four per-pair histograms (~10/pair left); zone-only drops every per-pair series (~0/pair, zone family plus the linear DNS/HTTP/external families remain). Anything but full requires serviceMonitor.enabled.",
              "enum": [
                "full",
                "counters-only",
                "zone-only"
              ]
            }
          }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "integer",
                  "number"
                ]
              }
            },
            "requests": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "integer",
                  "number"
                ]
              }
            },
            "claims": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "securityContext": {
          "type": "object",
          "properties": {
            "allowPrivilegeEscalation": {
              "type": "boolean"
            },
            "privileged": {
              "type": "boolean"
            },
            "readOnlyRootFilesystem": {
              "type": "boolean"
            },
            "runAsUser": {
              "type": "integer"
            },
            "runAsGroup": {
              "type": "integer"
            },
            "runAsNonRoot": {
              "type": "boolean"
            },
            "procMount": {
              "type": "string"
            },
            "capabilities": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "add": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "drop": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "seLinuxOptions": {
              "type": "object"
            },
            "seccompProfile": {
              "type": "object"
            },
            "appArmorProfile": {
              "type": "object"
            },
            "windowsOptions": {
              "type": "object"
            }
          }
        },
        "podSecurityContext": {
          "type": "object",
          "properties": {
            "runAsUser": {
              "type": "integer"
            },
            "runAsGroup": {
              "type": "integer"
            },
            "runAsNonRoot": {
              "type": "boolean"
            },
            "fsGroup": {
              "type": "integer"
            },
            "fsGroupChangePolicy": {
              "type": "string",
              "enum": [
                "OnRootMismatch",
                "Always"
              ]
            },
            "supplementalGroups": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "supplementalGroupsPolicy": {
              "type": "string"
            },
            "sysctls": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "value"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                }
              }
            },
            "seLinuxOptions": {
              "type": "object"
            },
            "seccompProfile": {
              "type": "object"
            },
            "appArmorProfile": {
              "type": "object"
            },
            "windowsOptions": {
              "type": "object"
            }
          }
        },
        "pingGroupRange": {
          "type": "boolean"
        },
        "priorityClassName": {
          "type": "string"
        },
        "updateStrategy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "RollingUpdate",
                "OnDelete"
              ]
            },
            "rollingUpdate": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "maxUnavailable": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "maxSurge": {
                  "type": [
                    "integer",
                    "string"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "anonymous",
                "local",
                "header",
                "oidc"
              ]
            },
            "anonymous": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "role": {
                  "description": "Fixed role for every anonymous request; one of the four built-ins.",
                  "type": "string",
                  "enum": [
                    "viewer",
                    "operator",
                    "alert-editor",
                    "admin"
                  ]
                }
              }
            },
            "defaultRole": {
              "description": "Role for an authenticated subject no binding matches; empty means none. A custom role name is not resolved here \u2014 the console refuses it at startup.",
              "type": "string",
              "enum": [
                "",
                "viewer",
                "operator",
                "alert-editor",
                "admin"
              ]
            },
            "local": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "bootstrapAdmin": {
                  "type": "string"
                },
                "existingSecret": {
                  "type": "string"
                },
                "existingSecretKey": {
                  "type": "string"
                },
                "secret": {
                  "$ref": "#/$defs/managedSecret"
                }
              }
            },
            "header": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "userHeader": {
                  "type": "string"
                },
                "groupsHeader": {
                  "type": "string"
                },
                "groupsDelimiter": {
                  "type": "string"
                },
                "trustedProxyCIDRs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "oidc": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "issuer": {
                  "type": "string"
                },
                "clientID": {
                  "type": "string"
                },
                "existingSecret": {
                  "type": "string"
                },
                "existingSecretKey": {
                  "type": "string"
                },
                "secret": {
                  "$ref": "#/$defs/managedSecret"
                },
                "redirectURL": {
                  "type": "string"
                },
                "scopes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "usernameClaim": {
                  "type": "string"
                },
                "groupsClaim": {
                  "type": "string"
                }
              }
            },
            "session": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ttl": {
                  "description": "Absolute session lifetime as a duration string. It has NO zero form: the console refuses to start on auth.session.ttl <= 0 (config.go), because a session with no lifetime is a session that never expires. Only idleTimeout below takes 0.",
                  "type": "string"
                },
                "idleTimeout": {
                  "description": "Duration string, or the integer 0 which disables the idle bound (documented in values.yaml and the READMEs).",
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "cookieName": {
                  "type": "string"
                },
                "secure": {
                  "type": "boolean"
                }
              }
            },
            "groupRoles": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              },
              "description": "Group asserted by the identity provider -> role this console grants. Union with API-made bindings; a group absent from the map grants nothing."
            }
          }
        },
        "controller": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "grpcAddr": {
              "description": "REMOVED: renamed to grpcAddress. Permissive here so the template's own fail message, which says what to do, wins over a bare schema rejection.",
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "type": "string"
            },
            "timeout": {
              "type": "string"
            },
            "grpcAddress": {
              "type": "string"
            }
          }
        },
        "prometheus": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string"
            },
            "queryTimeout": {
              "type": "string"
            },
            "maxRange": {
              "type": "string"
            },
            "maxResponseBytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "rateLimit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runsPerMinute": {
              "type": "integer",
              "minimum": 0
            },
            "loginPerMinute": {
              "type": "integer",
              "minimum": 0
            },
            "promqlPerMinute": {
              "description": "PromQL proxy requests per subject per minute; 0 disables the limit.",
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "scheduler": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "tickInterval": {
              "type": "string"
            }
          }
        },
        "mtr": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enrichment": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "rdns": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "timeoutMs": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "geoip": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "",
                        "auto",
                        "volume",
                        "disabled"
                      ]
                    },
                    "editions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "updateIntervalHours": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "reloadInterval": {
                      "description": "Duration string, or the integer 0 which never reloads (documented in values.yaml).",
                      "type": [
                        "string",
                        "integer"
                      ]
                    },
                    "image": {
                      "type": "object"
                    },
                    "resources": {
                      "type": "object"
                    },
                    "securityContext": {
                      "type": "object"
                    },
                    "existingSecret": {
                      "type": "string"
                    },
                    "accountIdKey": {
                      "type": "string"
                    },
                    "licenseKeyKey": {
                      "type": "string"
                    },
                    "secret": {
                      "$ref": "#/$defs/managedSecret"
                    },
                    "asnPath": {
                      "type": "string"
                    },
                    "cityPath": {
                      "type": "string"
                    },
                    "volume": {
                      "type": "object"
                    }
                  }
                },
                "ttl": {
                  "type": "string"
                }
              }
            }
          }
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            }
          }
        },
        "kubernetesContext": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespace": {
              "type": "string"
            },
            "resyncInterval": {
              "type": "string"
            }
          }
        },
        "webhooks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "encryptionKeySecret": {
              "description": "REMOVED: renamed to existingSecret / existingSecretKey. Permissive here so the template's own fail message wins over a bare schema rejection.",
              "type": [
                "object",
                "null"
              ]
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string"
            },
            "secret": {
              "$ref": "#/$defs/managedSecret"
            },
            "alertPollInterval": {
              "type": "string"
            }
          }
        },
        "alerting": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespace": {
              "type": "string"
            },
            "syncInterval": {
              "type": "string"
            },
            "bundleName": {
              "type": "string"
            }
          }
        },
        "securityContext": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object",
          "properties": {
            "runAsUser": {
              "type": "integer"
            },
            "runAsGroup": {
              "type": "integer"
            },
            "runAsNonRoot": {
              "type": "boolean"
            },
            "fsGroup": {
              "type": "integer"
            },
            "fsGroupChangePolicy": {
              "type": "string",
              "enum": [
                "OnRootMismatch",
                "Always"
              ]
            },
            "supplementalGroups": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "supplementalGroupsPolicy": {
              "type": "string"
            },
            "sysctls": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "value"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                }
              }
            },
            "seLinuxOptions": {
              "type": "object"
            },
            "seccompProfile": {
              "type": "object"
            },
            "appArmorProfile": {
              "type": "object"
            },
            "windowsOptions": {
              "type": "object"
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ingressFrom": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "prometheusEgress": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "redisEgress": {
              "description": "Egress rules to the Redis-compatible bus. Empty renders TCP 6379 to any pod or address.",
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "valkeyEgress": {
              "description": "REMOVED: renamed to redisEgress. Permissive here so the template's own fail message, which says what to do, wins over a bare schema rejection.",
              "type": [
                "array",
                "null"
              ]
            },
            "valkeyIngressFrom": {
              "description": "REMOVED: the chart installs no bus. Permissive here so the template's own fail message wins over a bare schema rejection.",
              "type": [
                "array",
                "null"
              ]
            },
            "databaseEgress": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "oidcEgress": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "kubeAPIEgress": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "geoipEgress": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "webhookEgress": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer",
                "ExternalName"
              ]
            },
            "port": {
