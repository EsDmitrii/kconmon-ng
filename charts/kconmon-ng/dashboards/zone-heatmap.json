          "editorMode": "code",
          "expr": "(sum by (source_zone, destination_zone) (increase(kconmon_ng_zone_udp_packets_sent_total[15m])) - sum by (source_zone, destination_zone) (increase(kconmon_ng_zone_udp_packets_received_total[15m]))) / sum by (source_zone, destination_zone) (increase(kconmon_ng_zone_udp_packets_sent_total[15m]))",
